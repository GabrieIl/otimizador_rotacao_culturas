# Copie este arquivo para .env caso utilize APIs externas
NASA_EARTHDATA_USERNAME=
NASA_EARTHDATA_PASSWORD=
NASA_APPEEARS_TOKEN=

# Text-to-Speech (opcional: "offline", "gtts" ou "openai")
CROP_OPT_TTS_PROVIDER=offline
OPENAI_API_KEY=

# Twilio WhatsApp API (opcional para envio real no campo)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Diretório raiz do Local Data Lakehouse (padrão: ./data)
CROP_OPT_DATA_DIR=./data

# Modo de ingestão: "offline" (sintético calibrado) ou "online" (APIs reais + fallback)
CROP_OPT_INGESTION_MODE=offline
